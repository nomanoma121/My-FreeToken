diff --git a/ggml/src/ggml-cuda/allreduce.cu b/ggml/src/ggml-cuda/allreduce.cu
index d56129a22..5b5a4cc76 100644
--- a/ggml/src/ggml-cuda/allreduce.cu
+++ b/ggml/src/ggml-cuda/allreduce.cu
@@ -304,6 +304,7 @@ struct ggml_cuda_ar_pipeline {
     size_t   copy_threshold;
     size_t   copy_chunk_bytes;
     size_t   bf16_threshold; // tensors >= this size (bytes) are reduced via FP32->BF16 round-trip; 0 disables
+    bool     no_host_sync;   // skip pool-lap cudaEventSynchronize; device-side arrival handshake already orders slot reuse
     uint64_t call_count;
 
     // Per-device resources.
@@ -362,7 +363,7 @@ static ggml_cuda_ar_slot_info ggml_cuda_ar_acquire_slot(ggml_cuda_ar_pipeline *
     const bool pool_lapped = p->call_count >= GGML_CUDA_AR_POOL_SIZE;
     p->call_count++;
 
-    if (pool_lapped) {
+    if (pool_lapped && !p->no_host_sync) {
         for (int i = 0; i < p->n_devices; ++i) {
             ggml_cuda_set_device(p->devices[i]);
             CUDA_CHECK(cudaEventSynchronize(p->ev_pool[i][slot].ker));
@@ -428,6 +429,13 @@ ggml_cuda_ar_pipeline * ggml_cuda_ar_pipeline_init(const int * devices, size_t n
     // ne).  Set GGML_CUDA_AR_BF16_THRESHOLD=0 to disable, or to a larger
     // byte threshold to opt out for small tensors.
     p->bf16_threshold   = ggml_cuda_ar_env_u64("GGML_CUDA_AR_BF16_THRESHOLD", 1);
+    // 1 = skip the per-AR host-side event sync on pool wraparound. Safe when all chunked ARs run
+    // on the caller compute streams (lockstep arrival handshake already orders slot reuse);
+    // lets whole decode steps capture into fewer CUDA graphs. Validate output quality!
+    p->no_host_sync     = ggml_cuda_ar_env_u64("GGML_CUDA_AR_NO_HOST_SYNC", 0) != 0;
+    if (p->no_host_sync) {
+        GGML_LOG_WARN("%s: GGML_CUDA_AR_NO_HOST_SYNC=1, skipping pool-lap host sync\n", __func__);
+    }
     for (size_t i = 0; i < n_devices; ++i) {
         p->devices[i] = devices[i];
     }
